{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/events", "dest": "/api/events/index.js" },
    { "src": "/api/events/(.*)", "dest": "/api/events/[id].js?id=$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
